{
  "name": "dsh-archived-sessions",
  "version": "0.1.0",
  "description": "Browse and restore archived sessions in the DeepSeek Harness web UI: list archived sessions from the sidebar, open any of them, and unarchive to restore the sidebar slot.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "src/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.0 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-web-app": ">=0.1.0-rc.0 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.0 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.0 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.0 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-app": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "license": "MIT"
}
